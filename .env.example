# =============================================================================
# AI Gateway — Environment Variables
# =============================================================================
# Copy to .env and fill in real values. NEVER commit .env to version control.
# =============================================================================

# --- GitHub Models API ---
# Fine-grained PAT with scope: models:read (Account Permission)
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_MODELS_PAT=github_pat_REPLACE_ME

# --- LiteLLM Proxy ---
# Master key for admin endpoints (/key/generate, /spend/logs, etc.)
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-CHANGE-ME-IN-PRODUCTION

# --- PostgreSQL (LiteLLM key/spend tracking) ---
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PW
DATABASE_URL=postgresql://litellm:CHANGE_ME_POSTGRES_PW@postgres:5432/litellm

# --- Redis (caching + rate limiting) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Presidio (PII detection) ---
PRESIDIO_ANALYZER_URL=http://presidio-analyzer:5001
PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer:5002

# --- GitHub MCP Server ---
# Fine-grained PAT with scopes: repo:read, issues:read, pull_requests:read+write
GITHUB_MCP_PAT=github_pat_REPLACE_ME_MCP

# --- Observability (optional) ---
# Langfuse
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=https://langfuse.internal

# Slack alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# --- Developer Workstation (set in ~/.bashrc) ---
# ANTHROPIC_BASE_URL=https://ai-gateway.internal:4000
# ANTHROPIC_AUTH_TOKEN=sk-team-xxx
